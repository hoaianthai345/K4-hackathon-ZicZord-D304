# Existing project rules
.DS_Store
node_modules/
*.env

# Local secrets
.env
.env.*
!.env.example

# JavaScript
npm-debug.log*

# Python
__pycache__/
.pytest_cache/
.venv/
*.py[cod]
codebase/backend/state/*.json
codebase/config/telegram-users.json
codebase/config/google-service-account.json
codebase/config/google-calendar-oauth-client.json
codebase/config/google-calendar-oauth-token.json
codebase/config/google-tasks-oauth.json

# Local Hindsight state and demo outputs
.hindsight/
codebase/tmp/
codebase/traces/*.json
!codebase/traces/.gitkeep

# Local Discord exports and derived datasets may contain personal data
codebase/data/raw/
codebase/data/processed/*
!codebase/data/processed/.gitkeep
eval/results/latest.json
eval/results/runs/
eval/results/*.partial.json
