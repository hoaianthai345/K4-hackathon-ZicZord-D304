# One-command MVP works without an external key.
MEMORY_PROVIDER=local
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated origins when local Docker serves a Vercel frontend.
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/ZicZordAI20K4Bot

# Authorized Discord snapshot from an Apify Dataset.
APIFY_TOKEN=
APIFY_DATASET_ID=
APIFY_API_BASE_URL=https://api.apify.com/v2

# Optional Tavily web search. Keep the real key only in ignored .env.
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# Flow-aware OpenRouter pool. Keep real keys only in ignored .env.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_PHUC=
OPENROUTER_API_KEY_KHANG=
OPENROUTER_API_KEY_TRINH=
OPENROUTER_CHAT_KEY_ORDER=khang,trinh,phuc,default
OPENROUTER_BRIEF_KEY_ORDER=phuc,khang,trinh,default
OPENROUTER_RAG_KEY_ORDER=trinh,phuc,khang,default
OPENROUTER_MODEL=qwen/qwen3.6-27b
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000

# Optional dedicated OpenAI-compatible LLM for RAG. Embeddings remain OpenRouter.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b

# Optional Telegram connector. Keep token/secret only in ignored .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_USER_MAP_PATH=/app/config/telegram-users.json
# Public demo identity. Leave empty to require an explicit allowlist mapping.
TELEGRAM_PUBLIC_USER_ID=U01862

# Google Calendar organizer. Use oauth for Gmail/personal Google accounts.
GOOGLE_CALENDAR_AUTH_MODE=oauth
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_OAUTH_CLIENT_FILE=/app/config/google-calendar-oauth-client.json
GOOGLE_CALENDAR_OAUTH_TOKEN_FILE=/app/state/google-calendar-oauth-token.json
GOOGLE_CALENDAR_ORGANIZER_EMAIL=
GOOGLE_CALENDAR_OAUTH_PORT=8765
# Service-account fallback for Google Workspace domain-wide delegation.
GOOGLE_CALENDAR_CREDENTIALS_FILE=/app/config/google-service-account.json
GOOGLE_CALENDAR_DELEGATED_USER=
GOOGLE_CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=60

# T004 pitch flow: create tasks from a team-only brief.
# Keep mock for a no-network demo. Use live with an authorized-user OAuth JSON.
GOOGLE_TASKS_MODE=mock
GOOGLE_TASKS_TASKLIST_ID=@default
GOOGLE_TASKS_ACCESS_TOKEN=
GOOGLE_TASKS_CREDENTIALS_FILE=/app/config/google-tasks-oauth.json
GOOGLE_TASKS_TIMEZONE=Asia/Ho_Chi_Minh

# Optional admin API protection. When empty, /admin is open for localhost demo.
# When set, enter this key in the admin page; it is kept in sessionStorage only.
ADMIN_API_KEY=

# RAG-Anything (official HKUDS repo, pinned by Docker build).
RAG_ANYTHING_COMMIT=65b7ffdeb801309d4c87b6accf81bfe5cd9b175d
RAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
RAG_EMBEDDING_DIMENSIONS=2048
# Hot-index budget for a 24-hour hackathon demo; PostgreSQL still stores all rows.
RAG_MAX_MESSAGES=8
RAG_MAX_EPISODES=12
RAG_MAX_PAINPOINTS=24
RAG_CHUNK_TOKEN_SIZE=3000
API_PUBLIC_URL=http://localhost:8000

# Structured/audit database. Compose provides safe demo defaults when omitted.
POSTGRES_USER=kute
POSTGRES_PASSWORD=kute_demo
POSTGRES_DB=kute

# Switch MEMORY_PROVIDER=hindsight and enable the Compose profile for live memory.
HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888

# Synthetic smoke-test identity only
DEMO_USER_ID=U01862

# Set to 1 only when intentionally testing the explicit-confirm path.
CONFIRM_DEMO_MEMORY=0
