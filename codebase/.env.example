# One-command MVP works without an external key.
MEMORY_PROVIDER=local
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated origins when local Docker serves a Vercel frontend.
FRONTEND_ORIGIN=http://localhost:3000

# Authorized Discord snapshot from an Apify Dataset.
APIFY_TOKEN=
APIFY_DATASET_ID=
APIFY_API_BASE_URL=https://api.apify.com/v2

# Primary answer model. Keep the key local and rotate it after the event.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000

# Optional dedicated OpenAI-compatible LLM for RAG. Embeddings remain OpenRouter.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b

# Optional admin API protection. When empty, /admin is open for localhost demo.
# When set, enter this key in the admin page; it is kept in sessionStorage only.
ADMIN_API_KEY=

# RAG-Anything (official HKUDS repo, pinned by Docker build).
RAG_ANYTHING_COMMIT=65b7ffdeb801309d4c87b6accf81bfe5cd9b175d
RAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
RAG_EMBEDDING_DIMENSIONS=2048
# Hot-index budget for a 24-hour hackathon demo; PostgreSQL still stores all rows.
RAG_MAX_MESSAGES=8
RAG_MAX_EPISODES=12
RAG_MAX_PAINPOINTS=24
RAG_CHUNK_TOKEN_SIZE=3000
API_PUBLIC_URL=http://localhost:8000

# Structured/audit database. Compose provides safe demo defaults when omitted.
POSTGRES_USER=kute
POSTGRES_PASSWORD=kute_demo
POSTGRES_DB=kute

# Paid alternative when the OpenRouter account has credit:
# OPENROUTER_MODEL=qwen/qwen3.6-27b

# Switch MEMORY_PROVIDER=hindsight and enable the Compose profile for live memory.
HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888

# Synthetic smoke-test identity only
DEMO_USER_ID=U01862

# Set to 1 only when intentionally testing the explicit-confirm path.
CONFIRM_DEMO_MEMORY=0
